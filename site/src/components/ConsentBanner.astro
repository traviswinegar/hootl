---
// Cookie-consent banner for Google Analytics (Consent Mode v2).
// Tracking stays denied (set as the default in Base.astro) until the
// visitor accepts here; the choice is remembered in localStorage.
---

<div id="consent-banner" class="consent-banner" role="dialog" aria-live="polite"
     aria-label="Cookie consent" hidden>
  <p class="consent-text">
    We use Google Analytics to understand site traffic. Analytics cookies are
    only set if you accept.
  </p>
  <div class="consent-actions">
    <button type="button" id="consent-decline" class="consent-btn consent-decline">
      Decline
    </button>
    <button type="button" id="consent-accept" class="consent-btn consent-accept">
      Accept
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = 'ga-consent';
    var banner = document.getElementById('consent-banner');
    function gtag() {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push(arguments);
    }
    var stored = null;
    try { stored = localStorage.getItem(KEY); } catch (e) {}
    if (stored !== 'granted' && stored !== 'denied') {
      banner.hidden = false;
    }
    function choose(granted) {
      try { localStorage.setItem(KEY, granted ? 'granted' : 'denied'); } catch (e) {}
      gtag('consent', 'update', {
        analytics_storage: granted ? 'granted' : 'denied',
      });
      banner.hidden = true;
    }
    document.getElementById('consent-accept')
      .addEventListener('click', function () { choose(true); });
    document.getElementById('consent-decline')
      .addEventListener('click', function () { choose(false); });
  })();
</script>

<style>
  .consent-banner[hidden] {
    display: none;
  }

  .consent-banner {
    position: fixed;
    bottom: var(--space-4);
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    width: calc(100% - 2 * var(--space-4));
    max-width: var(--max-w-prose);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    background: var(--deep-teal);
    color: var(--cream);
    border-radius: 0.5rem;
    box-shadow: 0 8px 24px rgba(15, 61, 74, 0.35);
  }

  .consent-text {
    margin: 0;
    flex: 1 1 18rem;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .consent-actions {
    display: flex;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  .consent-btn {
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 600;
    padding: var(--space-2) var(--space-4);
    border-radius: 0.375rem;
    border: 1px solid transparent;
    cursor: pointer;
  }

  .consent-accept {
    background: var(--teal);
    color: var(--paper);
  }

  .consent-accept:hover {
    background: var(--mid-teal);
  }

  .consent-decline {
    background: transparent;
    color: var(--cream);
    border-color: var(--mid-teal);
  }

  .consent-decline:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  @media (max-width: 32rem) {
    .consent-banner {
      flex-direction: column;
      align-items: stretch;
    }
    .consent-actions {
      justify-content: flex-end;
    }
  }
</style>
